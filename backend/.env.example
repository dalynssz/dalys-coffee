# =====================================================
# CONFIGURACIÓN DEL BACKEND DE DALY'S COFFEE
# Copia este archivo como ".env" (en esta misma carpeta)
# y cambia los valores. El archivo .env NUNCA se sube a GitHub.
# =====================================================

# Puerto del servidor en tu computador
PORT=3000

# Conexión a MongoDB Atlas (Connect > Drivers > Node.js).
# Reemplaza <db_password> por la contraseña del usuario de la base de datos
# y agrega el nombre de la base "dalyscoffee" antes del "?".
MONGODB_URI=mongodb+srv://dalys_admin:<db_password>@cluster0.xxxxx.mongodb.net/dalyscoffee?retryWrites=true&w=majority

# Texto largo y aleatorio para firmar las sesiones del admin.
# Puedes generarlo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Usuario administrador que crea "npm run seed".
# La contraseña se guarda cifrada en la base de datos.
ADMIN_USERNAME=daly
ADMIN_PASSWORD=elige-una-contraseña-segura

# Páginas que pueden usar esta API (separadas por coma)
FRONTEND_URL=http://localhost:5173,https://dalynssz.github.io
